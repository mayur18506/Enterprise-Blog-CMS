@{
    ViewData["Title"] = "Enterprise Blog & CMS";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Enterprise Blog & CMS</h2>
            <p class="text-muted">Powered by ASP.NET Core MVC, Repository Pattern & React.js</p>
        </div>
        <div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="me-3 fw-semibold">Hi, @User.Identity.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                <a href="/Articles/Create" class="btn btn-primary me-2">+ Write Article</a>
                <a href="/Account/Logout" class="btn btn-outline-danger">Logout</a>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-dark">Login / Admin Access</a>
            }
        </div>
    </div>

    <!-- React.js Root Container -->
    <div id="react-blog-app"></div>
</div>

<!-- Load React.js & Babel for Dynamic UI -->
<script src="https://unpkg.com/react@@18/umd/react.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@@18/umd/react-dom.development.js" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
<script type="text/babel">
    const { useState, useEffect } = React;

    function BlogFeed() {
        const [articles, setArticles] = useState([]);
        const [search, setSearch] = useState("");
        const [category, setCategory] = useState("");

        const fetchArticles = async () => {
            const params = new URLSearchParams({ search, category });
            const res = await fetch(`/api/articles?${params.toString()}`);
            const data = await res.json();
            setArticles(data);
        };

        useEffect(() => {
            fetchArticles();
        }, [search, category]);

        return (
            <div>
                <div className="row mb-4">
                    <div className="col-md-8">
                        <input
                            type="text"
                            className="form-control"
                            placeholder="Search articles dynamically with React..."
                            value={search}
                            onChange={(e) => setSearch(e.target.value)}
                        />
                    </div>
                    <div className="col-md-4">
                        <select className="form-select" value={category} onChange={(e) => setCategory(e.target.value)}>
                            <option value="">All Categories</option>
                            <option value="Technology">Technology</option>
                            <option value="Architecture">Architecture</option>
                            <option value="Cloud & AI">Cloud & AI</option>
                        </select>
                    </div>
                </div>

                {articles.length === 0 ? (
                    <div className="alert alert-info">No articles found. Login and click "+ Write Article" to publish!</div>
                ) : (
                    <div className="row">
                        {articles.map((art) => (
                            <div className="col-md-6 mb-4" key={art.id}>
                                <div className="card shadow-sm h-100">
                                    <div className="card-body">
                                        <span className="badge bg-primary mb-2">{art.category}</span>
                                        <h4 className="card-title fw-bold">{art.title}</h4>
                                        <p className="card-text text-secondary">{art.content}</p>
                                    </div>
                                    <div className="card-footer bg-white d-flex justify-content-between align-items-center">
                                        <small className="text-muted">By {art.authorName} • {new Date(art.createdAt).toLocaleDateString()}</small>
                                        <form method="post" action={`/Articles/Delete/${art.id}`}>
                                            <button type="submit" className="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        );
    }

    const root = ReactDOM.createRoot(document.getElementById('react-blog-app'));
    root.render(<BlogFeed />);
</script>